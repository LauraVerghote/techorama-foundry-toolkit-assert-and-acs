# Copy to .env, replace every <placeholder> with values from your Azure
# subscription and Foundry project, and never commit .env.

# Azure OpenAI-compatible endpoint used by local evaluations.
AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION=2025-03-01-preview
ASSERT_AZURE_USE_AAD=1

# Azure subscription and existing Foundry project used for hosted deployment.
AZURE_ENV_NAME=bank-manager-demo-yourname
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_LOCATION=<your-azure-region>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_AI_ACCOUNT_NAME=<your-foundry-account>
AZURE_AI_PROJECT_NAME=<your-foundry-project>
AZURE_AI_PROJECT_ID=/subscriptions/<your-subscription-id>/resourceGroups/<your-resource-group>/providers/Microsoft.CognitiveServices/accounts/<your-foundry-account>/projects/<your-foundry-project>
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-foundry-project>
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-foundry-project>

# These deployment names must exist in the configured Foundry account.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.6-terra
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_AI_TOOLKIT_EVALUATOR_MODEL_DEPLOYMENT_NAME=gpt-4.1
AZURE_AI_EVALUATOR_MODEL_DEPLOYMENT_NAME=gpt-5.5

# Alternatively, use an API key only if your organization's policy permits it.
# AZURE_API_KEY=

# Local policy knowledge base. No Azure Search resource is required.
KB_BACKEND=mock
KB_CORPUS_DIR=bank_manager/runtime/knowledge

# Optional explicit viewer model list.
# ASSERT_MODEL_OPTIONS=azure/gpt-5.6-terra
# ASSERT_DEFAULT_MODEL=azure/gpt-5.6-terra